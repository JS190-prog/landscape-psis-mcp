# Final recommended usage for public shared server:
# ChatGPT New App URL = https://YOUR_DOMAIN/mcp?psisApiKey=USER_ISSUED_PSIS_KEY
# or https://YOUR_DOMAIN/mcp?apiKey=USER_ISSUED_PSIS_KEY

PORT=3000
PUBLIC_BASE_URL=

# Optional fallback 1: server-side shared API key. Leave empty if users bring their own key in the URL.
PSIS_API_KEY=

# Optional fallback 2: full PSIS URL style. Leave empty for query-key public use.
# PSIS_API_BASE_URL=http://psis.rda.go.kr/openApi/service.do?apiKey=YOUR_KEY&serviceCode=SVC01&serviceType=AA001
PSIS_API_BASE_URL=

# Optional. Default is AA001, which is machine-readable XML for server parsing.
PSIS_SERVICE_TYPE=AA001


# ChatGPT public MCP tool exposure.
# fit-only exposes only check_landscape_pesticide_fit to reduce repeated tool approval prompts.
# Use all only for admin/debug connectors.
MCP_PUBLIC_TOOLS=fit-only

# PSIS HTTP client mode: fetch-first or node. Use node if your VPS shows fetch failed.
PSIS_HTTP_CLIENT=fetch-first

# PSIS request protection.
REQUEST_TIMEOUT_MS=15000
MAX_DISPLAY_COUNT=50
FIT_MAX_CANDIDATE_SEARCHES=10
FIT_SEARCH_DISPLAY_COUNT=10
FIT_MAX_RETURNED_ITEMS=100
MAX_DETAIL_LOOKUPS=5

# In-memory cache. Helps your VPS and PSIS API by reusing identical searches.
CACHE_ENABLED=true
CACHE_TTL_MS=21600000
CACHE_MAX_ENTRIES=1000

# Public server protection.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=60
RATE_LIMIT_MAX_PER_KEY=60

# Safe logging: logs method/path/status only, never query strings or API keys.
SAFE_ACCESS_LOG=true
